# ═══════════════════════════════════════════════════════
#  NeuroAgent — Environment Configuration
#  Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════

# ── OpenAI ──────────────────────────────────────────────
# Set MOCK_LLM=true to run without a real key (stub responses)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MOCK_LLM=true

# ── PostgreSQL + pgvector ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://neuro:neuro_secret@localhost:5432/neuro_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Agent Settings ───────────────────────────────────────
MAX_AGENT_STEPS=10
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2.0
TASK_TIMEOUT_SECONDS=120

# ── RAG Settings ─────────────────────────────────────────
VECTOR_DIM=1536
RAG_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Web Search ────────────────────────────────────────────
SEARCH_PROVIDER=duckduckgo   # options: duckduckgo | brave | serpapi
SERPAPI_KEY=                 # if using serpapi
BRAVE_API_KEY=               # if using brave

# ── API Server ────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info
ENVIRONMENT=development      # development | production
